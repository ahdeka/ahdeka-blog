# 이 파일을 .env.local 로 복사해서 값을 채울 것. Vercel에는 Project Settings > Environment Variables 에 등록
# NEXT_PUBLIC_ 이 붙은 값만 브라우저에 노출됨 (그 외는 서버 전용)

# Vercel: Production = 실제 도메인(필수, 끝에 / 없이), Preview = 비워 두면 배포 주소(VERCEL_URL) 사용
#   Production = prod Supabase · 운영 Turnstile 키 / Preview = dev Supabase · 테스트 키 가능
#   (Production에 Turnstile 테스트 키를 넣으면 댓글 등록이 거부됨)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ⚠️ 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 말 것 (RLS를 우회하는 키)
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile — 로컬 개발은 아래 공식 테스트 키(항상 통과)를 사용
# 운영 키는 Cloudflare Dashboard > Turnstile 에서 위젯 생성 후 발급
# 사이트 키 1x…BB = 항상 통과 + 화면에 안 보임 (1x…AA는 항상 보임)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 댓글 작성자 IP를 HMAC으로 해시할 때 쓰는 비밀값 (32자 이상)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COMMENT_IP_HASH_SECRET=
